# %%
import os
import sys
sys.path.append('../')

from src.signal_processing import generate_mock_field_data, clean_telemetry_data
from src.fatigue_analysis import generate_mock_lab_data, evaluate_correlation
from src.failure_logger import DfmeaManager

# Create mock environment structures
os.makedirs('../data', exist_ok=True)
generate_mock_field_data()
generate_mock_lab_data()

# %% Execute Field-to-Lab Correlation
results = evaluate_correlation('../data/raw_field_telemetry.csv', '../data/lab_rig_profile.csv')
print("--- Correlation Results ---")
print(f"Lab Acceleration Factor: {results['acceleration_factor']:.2f}x")
print(f"Rig Profile Assessment: {results['status']}\n")

# %% Initialize Automated DFMEA Log from Field Observations
manager = DfmeaManager('../config/reliability_targets.json')
manager.log_failure_mode("Dynamic Fatigue Clevis Crack", severity=8, occurrence=6, detection=4) # RPN = 192
manager.log_failure_mode("Surface Wear Spalling", severity=4, occurrence=2, detection=3)       # RPN = 24

manager.export_to_dvp('../data/dvp_status.csv')
print("DVP status report generated successfully under data/dvp_status.csv")
